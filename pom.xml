<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>Mezi</groupId>
  <artifactId>mezi-compiler</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>mezi-compiler</name>
  <description>mezi language compiler</description>
  
  <properties>
    <javaVersion>1.8</javaVersion>
    <asmVersion>9.8</asmVersion>
    <slf4jVersion>1.7.22</slf4jVersion>
    <log4jVersion>1.2.16</log4jVersion>
    <parserDir>${project.basedir}/src/main/java/mezic/parser</parserDir>
    <generatedParserDir>${project.build.directory}/generated-sources/javacc</generatedParserDir>
  </properties>
  
  
  <dependencies>
	<dependency>
	    <groupId>org.ow2.asm</groupId>
	    <artifactId>asm</artifactId>
	    <version>${asmVersion}</version>
	</dependency>
	<dependency>
	    <groupId>org.ow2.asm</groupId>
	    <artifactId>asm-tree</artifactId>
	    <version>${asmVersion}</version>
	</dependency>
	<dependency>
		<groupId>org.slf4j</groupId>
		<artifactId>slf4j-log4j12</artifactId>
		<version>${slf4jVersion}</version>
	</dependency>
	<dependency>
		<groupId>log4j</groupId>
		<artifactId>log4j</artifactId>
		<version>${log4jVersion}</version>
		<scope>runtime</scope>
	</dependency>
  </dependencies>
  
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>generate-parser-jjtree</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <workingDirectory>${parserDir}</workingDirectory>
              <executable>jjtree</executable>
              <arguments>
                <argument>-OUTPUT_DIRECTORY=${generatedParserDir}</argument>
                <argument>Parser.jjt</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>generate-parser-javacc</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <workingDirectory>${generatedParserDir}</workingDirectory>
              <executable>javacc</executable>
              <arguments>
                <argument>-OUTPUT_DIRECTORY=${generatedParserDir}</argument>
                <argument>Parser.jj</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>remove-overlapping-generated-files</id>
            <phase>generate-sources</phase>
            <configuration>
              <target>
                <delete file="${generatedParserDir}/Node.java" quiet="true" />
                <delete file="${generatedParserDir}/SimpleNode.java" quiet="true" />
                <delete file="${generatedParserDir}/Token.java" quiet="true" />
              </target>
            </configuration>
            <goals>
              <goal>run</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-generated-parser-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${generatedParserDir}</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.1</version>
        <configuration>
          <source>${javaVersion}</source>
          <target>${javaVersion}</target>
        </configuration>
      </plugin>
    </plugins>
  </build>
  
</project>
